{
  "name": "api",
  "version": "2.0.0",
  "description": "Fit Focus API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=phase-",
    "test:integration": "jest --runInBand --testPathPattern=integration",
    "test:phase0": "jest --runInBand tests/phase-0",
    "test:phase1": "jest --runInBand tests/phase-0 tests/phase-1",
    "test:phase2": "jest --runInBand tests/phase-0 tests/phase-1 tests/phase-2",
    "test:phase3": "jest --runInBand tests/phase-0 tests/phase-1 tests/phase-2 tests/phase-3",
    "typecheck": "tsc --noEmit"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.2",
    "express": "^4.18.1",
    "jsonwebtoken": "^8.5.1",
    "mercadopago": "^1.5.14",
    "mongoose": "^6.6.0",
    "nodemailer": "^6.7.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^11.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
