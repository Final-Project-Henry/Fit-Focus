PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/fitfocus
SECRET=change-me-to-a-long-random-jwt-secret

# Gmail App Password (recuperación / mails)
NODEMAILER=

# Mercado Pago — Access Token (único requerido para pagos)
# Dashboard: https://www.mercadopago.com.pe/developers/panel/app
# Credenciales de prueba → Access Token (empieza con TEST-...)
# Credenciales de producción → Access Token (empieza con APP_USR-...)
ACCESS_TOKEN=

# Con token TEST- se usa sandbox_init_point automáticamente.
# Pon true para forzar sandbox aunque el token sea APP_USR-...
MERCADOPAGO_USE_SANDBOX=false

# URL del client (back_urls de Mercado Pago)
CLIENT_URL=http://localhost:3000

# Google OAuth (opcional en local)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIRECT_URI=http://localhost:3001/authGoogle
